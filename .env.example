# ===== 글 작성 AI 1순위: 딥시크 (유료, 글 한 편 비용이 아주 적음) =====
# https://platform.deepseek.com/api_keys 에서 발급, 잔액을 충전해야 동작합니다.
DEEPSEEK_API_KEY=
# 더 꼼꼼한 글을 원하면 deepseek-v4-pro (비용이 더 듭니다)
DEEPSEEK_MODEL=deepseek-flash

# ===== 글 작성 AI 2순위: Gemini (무료 등급) =====
# Google AI Studio 에서 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ===== 로컬 AI (키 없이 쓰는 방법, https://ollama.com/download) =====
# 설치 후 명령 프롬프트에서  ollama pull gemma3:4b  한 번만 실행하면 됩니다.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# 응답 대기 한도(밀리초). 느린 컴퓨터에서 글이 중간에 끊기면 늘립니다. 기본 10분.
OLLAMA_TIMEOUT=600000

# ===== AI 그림 1순위: OpenAI GPT Image 2 (키를 넣으면 사진 자리마다 그림을 새로 그립니다) =====
# https://platform.openai.com/api-keys 에서 발급(sk-proj- 로 시작, sk-admin- 관리자 키는 안 됩니다), Billing 에서 충전해야 동작합니다.
# 실패하면(잔액 부족·키 오류 등) 아래 Pollinations 나 무료 사진으로 대신합니다.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# 화질: low / medium / high. 그림 값은 low 장당 약 8원($0.006)이고, 여기에 글 내용을 담은 그림 지시문 값이 더 붙습니다.
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024
# 사진 기록(data/logs/사진기록.csv, 사진사용량.json)의 금액 계산용. OpenAI 가 응답마다 알려 주는 사용량(토큰)에 곱합니다.
# 지시문 1M 토큰당 달러 / 그림 1M 토큰당 달러 / 1달러당 원. OpenAI 가격표나 환율이 바뀌면 고칩니다.
OPENAI_IMAGE_PRICE_TEXT_IN=5
OPENAI_IMAGE_PRICE_IMAGE_OUT=30
OPENAI_USD_KRW=1400

# ===== AI 그림 2순위 (구독 키를 넣으면 무료 사진 대신 그림을 그려 블로그에 넣습니다) =====
# https://enter.pollinations.ai 에서 구독 후 발급
POLLINATIONS_API_KEY=
# flux 가 기본입니다. 구독 등급에 따라 nanobanana, seedream 등으로 바꿀 수 있습니다.
POLLINATIONS_MODEL=flux

# ===== 사진 보정 =====
# bright: 밝고 화사하게(중간 밝기 올림·아주 살짝 발그레한 빛·칙칙한 색만 조금 살림·은은한 빛 번짐) — 기본
# natural: 색은 그대로 두고 대비·윤곽만 또렷하게(예전 방식)
BLOG_IMAGE_TONE=bright

# ===== 무료 이미지 (키가 없어도 Openverse/Picsum 으로 동작합니다) =====
# https://pixabay.com/api/docs/   (가입 후 바로 발급, 출처 표기 불필요)
PIXABAY_API_KEY=
# https://www.pexels.com/api/     (가입 후 바로 발급, 월 20,000건)
PEXELS_API_KEY=
# https://unsplash.com/developers (시간당 50건)
UNSPLASH_ACCESS_KEY=

# ===== 최신 정보 (글 쓰기 전에 키워드를 조합해 최신 기사를 찾아 AI 에게 줌) =====
# 키 없이 Bing·Google 뉴스에서 찾습니다. 끄려면 off
BLOG_LATEST_NEWS=on
# 앞쪽 기사 6건은 원문을 열어 요약 문장을 읽어 AI 에게 줍니다(아기 키워드는 소아·영유아로도 찾음). 끄려면 off
BLOG_READ_ARTICLES=on

# ===== 네이버 검색 API (선택, 소재 조사용) =====
# https://developers.naver.com/apps  검색 API 추가 후 발급 (일 25,000건 무료)
# 넣으면 최신 정보 찾기에 네이버 뉴스(최신순)도 함께 씁니다. 네이버 블로그는 찾지 않습니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== 내 블로그 아이디 (비워 두면 로그인 정보로 자동 확인합니다) =====
NAVER_BLOG_ID=

# ===== 소제목 인용구 (on = 네이버 인용구 상자로 넣기, off = 일반 소제목 글자로 넣기) =====
QUOTE_HEADINGS=on
# 인용구 모양 (quotation_line = 왼쪽 세로선, default = 큰따옴표, quotation_bubble = 말풍선, quotation_underline = 밑줄, quotation_postit = 포스트잇, quotation_corner = 프레임)
QUOTE_STYLE=quotation_line

# ===== 서론 첫 인사말 (비워 두면 인사말 없이 시작합니다) =====
# | 자리에서 줄을 바꿉니다.
BLOG_GREETING=안녕하세요. 재쁜이 아빠|육아박사 육박사입니다.
# 목표 글자수(공백 제외, 약). 이 값의 ±10%(기본 1800~2200자)로 쓰게 하고, 90% 보다 짧으면 AI 에게 한 번 더 늘려 쓰게, 115% 보다 길면 한 번 더 줄여 쓰게 합니다. (인사말·요약·태그·사진 설명은 세지 않음)
BLOG_MIN_CHARS=2000
# 다 쓴 글을 AI 가 한 번 더 읽어 어색한 문장·논리 오류·조사 오류만 고칩니다(1~2분 더 걸림). off 면 하지 않음
BLOG_PROOFREAD=on
# 문장 끝 말투 (casual = ~해요·~거든요·~죠 섞은 친근한 구어체(기본), formal = ~합니다·~습니다로 끝냄)
BLOG_TONE=casual

# ===== 글꼴과 제목 정렬 (기준 완성 글과 같게) =====
# 제목·본문 글꼴 (nanummaruburi = 나눔마루부리, nanumgothic = 나눔고딕, off = 고르지 않음). 글을 친 뒤 글꼴·크기·색이 틀리면 다시 맞춥니다.
BLOG_FONT=nanummaruburi
# 제목 칸 정렬 (left = 왼쪽, center = 가운데)
BLOG_TITLE_ALIGN=left
# 서론·본론·결론에서 문단과 문단 사이 빈 줄 수 (기본 1, 0 이면 빈 줄 없음)
BLOG_PARAGRAPH_GAP=1
# 문장이 끝나면 다음 줄에서 새 문장 시작 (on), off 면 25자 안에서 짧은 문장끼리 한 줄로 합침
BLOG_SENTENCE_BREAK=on
# 서론·본론·결론에서 문장이 끝나면(~예요. ~죠. ~다. ~나요?) 빈 줄 하나 (on), off 면 빈 줄은 문단 끝에만
BLOG_SENTENCE_GAP=on

# ===== 글 처음 여는 부분 (on = 스티커 + 제목 두 줄 + 출처 줄을 가운데에, off = 넣지 않음) =====
BLOG_OPENING=on
# 글 맨 위(스티커 위) 썸네일: on = 제목의 궁금증을 키우는 그림 + 문구(기본), off = 만들지 않음
BLOG_TOP_IMAGE=on
BLOG_CREDIT=글, 사진, 영상 ©육박사
# 맨 위 스티커: 묶음,줄,칸 (묶음은 스티커 창 위쪽 단추를 맨 왼쪽 시계부터 센 순서, 줄·칸은 목록의 위·왼쪽부터). off 면 넣지 않음
BLOG_STICKER=1,4,2
# 서론이 끝난 뒤 스티커 (같은 방식, off 면 넣지 않음)
BLOG_STICKER_INTRO=1,4,1
# 육박사의 간단 요약 바로 앞 스티커 (같은 방식, off 면 넣지 않음)
BLOG_STICKER_SUMMARY=1,4,2
# 태그 바로 앞 스티커, 앞에 Enter 한 번 (같은 방식, off 면 넣지 않음)
BLOG_STICKER_TAGS=5,3,1
# 강조 색을 끝낸 뒤 돌아갈 본문 글자색 (블로그 기본 서체 색과 같게)
BLOG_TEXT_COLOR=#333333

# ===== 본문 정렬 (center = 가운데, left = 왼쪽) =====
BLOG_ALIGN=center

# ===== 본문 한 줄 글자수 (띄어쓰기 포함, 이 글자수에서 줄을 바꿉니다. 0 = 줄바꿈 안 함) =====
BLOG_LINE_CHARS=20

# ===== 결론 다음 간단 요약 제목 (비워 두면 간단 요약을 넣지 않습니다) =====
BLOG_SUMMARY_TITLE=육박사의 간단 요약
# 간단 요약 목록 한 줄 글자수(띄어쓰기 포함)
BLOG_SUMMARY_CHARS=17

# ===== 입력 속도 (숫자가 작을수록 빠릅니다) =====
TYPE_DELAY=8
